{
  "name": "dsh-devin-search-next",
  "version": "1.0.2",
  "description": "Devin sign-in plus Devin-backed web_search and code_search for DeepSeek Harness. Zero harness runtime imports, so a DSH upgrade cannot break it.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "devin",
    "windsurf",
    "web-search",
    "code-search"
  ],
  "license": "MIT",
  "author": "gongstudent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongstudent/dsh-devin-search-next.git"
  },
  "homepage": "https://github.com/gongstudent/dsh-devin-search-next#readme",
  "bugs": {
    "url": "https://github.com/gongstudent/dsh-devin-search-next/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
